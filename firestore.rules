rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Règles pour les campagnes
    match /campaigns/{campaignId} {
      // Lecture : tout le monde peut lire les campagnes
      allow read: if true;
      
      // Écriture : seuls les utilisateurs authentifiés peuvent créer/modifier
      allow create: if request.auth != null;
      allow update: if request.auth != null && 
        (request.auth.uid == resource.data.createdBy || 
         request.auth.token.admin == true);
      allow delete: if request.auth != null && 
        (request.auth.uid == resource.data.createdBy || 
         request.auth.token.admin == true);
    }
    
    // Règles pour les participants
    match /participants/{participantId} {
      // Lecture : tout le monde peut lire les participants
      allow read: if true;
      
      // Écriture : seuls les utilisateurs authentifiés peuvent s'inscrire
      allow create: if request.auth != null;
      
      // Modification : seul le participant lui-même peut modifier son statut
      allow update: if request.auth != null && 
        (request.auth.uid == resource.data.donorId || 
         request.auth.token.admin == true);
      
      // Suppression : seul l'admin ou le participant lui-même
      allow delete: if request.auth != null && 
        (request.auth.uid == resource.data.donorId || 
         request.auth.token.admin == true);
    }
    
    // Règles pour les utilisateurs
    match /users/{userId} {
      // Lecture : seul l'utilisateur lui-même peut lire ses données
      allow read: if request.auth != null && request.auth.uid == userId;
      
      // Écriture : seul l'utilisateur lui-même peut créer/modifier ses données
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}

